{%- comment -%}
  Renders a single publication card from _data/papers.yml.
  Usage: {% include paper_entry.liquid paper=paper %}
  Pass standalone=true on the paper's own page, where the title is already the page heading.
{%- endcomment -%}
{%- assign paper = include.paper -%}
<div class="row">
  <div class="col col-sm-2 abbr">
    {%- if paper.abbr -%}
      <abbr class="badge rounded w-100">{{ paper.abbr }}</abbr>
    {%- endif -%}
  </div>
  <div id="{{ paper.key }}" class="col col-sm-10">
    {%- unless include.standalone -%}
      <div class="title">
        <a href="{{ '/publications/' | append: paper.key | append: '/' | relative_url }}">{{ paper.title }}</a>
      </div>
    {%- endunless -%}
    <div class="author">{{ paper.authors }}</div>
    <div class="periodical">
      <em>{{ paper.venue }}</em>{% if paper.year %}, {{ paper.year }}{% endif %}{% if paper.award %}, {{ paper.award }}{% endif %}{% if paper.note %} <span class="periodical-note">({{ paper.note }})</span>{% endif %}
    </div>
    <div class="links">
      {%- for link in paper.links -%}
        <a href="{{ link[1] }}" class="btn btn-sm z-depth-0" role="button" target="_blank" rel="noopener noreferrer">{{ link[0] }}</a>
      {%- endfor -%}
    </div>
  </div>
</div>
